flowchart TD
  BOOT([Khởi động dev]) --> ONE{"Đã có platform_users?"}
  ONE -->|Không| SA["Tạo duy nhất superadmin / 123456 · ACTIVE + READY"]
  ONE -->|Có| KEEP["Giữ nguyên mật khẩu và tài khoản hiện có"]
  SA --> PLOGIN["Đăng nhập /platform · JWT scope PLATFORM · không tenantId"]
  KEEP --> PLOGIN
  PLOGIN --> TENANT["Transaction: tenant + Admin ban đầu + role + audit PLATFORM"]
  TENANT --> TLOGIN["Admin đăng nhập workspace tenant · JWT scope TENANT"]
  TLOGIN --> WHO{"Người quản lý tài khoản"}
  WHO -->|Admin| ALL["STAFF / TEACHER / STUDENT; role hợp lệ"]
  WHO -->|Học vụ| LEARNING["Chỉ GV/HS thuần; tài khoản quản lý trả 404"]
  ALL --> CODE["Sinh GV/HS code bằng counter khóa theo tenant"]
  LEARNING --> CODE
  CODE --> READY["ACTIVE + READY · credential 123456"]
  READY --> ACTION{"Sửa / khóa / mở / reset"}
  ACTION --> GUARD["Kiểm tra scope + version + self + last active Admin"]
  GUARD -->|Sai| ROLLBACK["Rollback · RFC 7807"]
  GUARD -->|Đúng| AUDIT["Transaction before/after/reason · tăng token_version"]
  AUDIT --> REVOKE["JWT cũ mất hiệu lực ở request kế tiếp"]
  PLOGIN --> BLOCK["Gọi API nghiệp vụ tenant → 403"]
