SPRING_PROFILES_ACTIVE=dev
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:55433/class_management
DATABASE_USERNAME=class_app
DATABASE_PASSWORD=class_app_dev
DB_POOL_MAX=10

JWT_SECRET=dev-only-secret-must-be-at-least-32-bytes-long
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
APP_PUBLIC_URL=http://localhost:4173

PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_PASSWORD=123456
PLATFORM_ADMIN_EMAIL=superadmin@example.local
DEFAULT_ACCOUNT_PASSWORD=123456

GMAIL_OAUTH_ENABLED=false
GOOGLE_GMAIL_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_GMAIL_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/api/v1/oauth/google/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=base64-32-byte-key
GMAIL_OAUTH_STATE_TTL=PT10M
GMAIL_OUTBOX_RETENTION=PT72H
GMAIL_HTTP_TIMEOUT=PT10S

STORAGE_ROOT=./var/private-files
STAGING_ROOT=./var/staging-files
TENANT_DEFAULT_QUOTA_BYTES=53687091200
FILE_IMAGE_LIMIT_BYTES=52428800
FILE_SUBMISSION_IMAGE_LIMIT_BYTES=10485760
FILE_DOCUMENT_LIMIT_BYTES=52428800
FILE_AUDIO_LIMIT_BYTES=209715200
SUBMISSION_MAX_FILES=10
STAGING_TTL=PT24H
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=PT10S
CLAMAV_ENABLED=false
MAINTENANCE_FLAG_PATH=./var/maintenance.flag
BACKUP_DIRECTORY=./var/backups
BACKUP_RETENTION_DAYS=7
